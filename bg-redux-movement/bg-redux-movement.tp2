BACKUP ~bg-redux-movement/backup~
AUTHOR ~Zach Hopkins / BG Pathfinding Redux~
VERSION ~0.1.9-mp-experimental~
README ~bg-redux-movement/README.md~

BEGIN ~BG Pathfinding Redux: allied movement and spacing (BGEE / SoD / BG2EE preview)~
  DESIGNATED 0
  REQUIRE_PREDICATE (GAME_IS ~bgee bg2ee eet~)
    ~This preview requires BGEE, SoD, BG2EE or EET using a supported Windows executable.~
  REQUIRE_PREDICATE (FILE_EXISTS ~EEex.dll~)
    ~Install EEex first and launch through InfinityLoader.exe.~
  REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~mrdx-movement/mrdx-movement.tp2~ 0)
    ~Uninstall the older component using setup-mrdx-movement.exe first, then install this package. Your previous settings will be copied if the new settings file does not exist.~
  REQUIRE_PREDICATE (NOT FILE_EXISTS ~override/M_MRIP.lua~)
    ~An older movement overlay remains at override/M_MRIP.lua. Uninstall the old package first; for a manually installed prototype, back up and remove that old overlay before installing this package.~
  ACTION_IF NOT (FILE_EXISTS ~InfinityLoader.exe~ OR FILE_EXISTS ~EEex.exe~) BEGIN
    PRINT ~WARNING: No standard EEex launcher name found. Installation will continue; start the game using your EEex launcher.~
  END
  OUTER_SPRINT bg_redux_exe ~~
  ACTION_IF FILE_EXISTS ~Baldur.exe~ BEGIN
    OUTER_SPRINT bg_redux_exe ~Baldur.exe~
  END ELSE ACTION_IF FILE_EXISTS ~BaldurII.exe~ BEGIN
    OUTER_SPRINT bg_redux_exe ~BaldurII.exe~
  END ELSE ACTION_IF FILE_EXISTS ~SiegeOfDragonspear.exe~ BEGIN
    OUTER_SPRINT bg_redux_exe ~SiegeOfDragonspear.exe~
  END
  ACTION_IF (~%bg_redux_exe%~ STRING_EQUAL ~~) BEGIN
    PRINT ~WARNING: No standard game executable name found. Installation will continue; EEex must launch your executable. Runtime native checks remain active.~
  END ELSE ACTION_IF NOT (FILE_MD5 EVALUATE_BUFFER ~%bg_redux_exe%~ ~6439dc555d7b5b91c2aa59bb0f32b271~ OR FILE_MD5 EVALUATE_BUFFER ~%bg_redux_exe%~ ~68d3b46a164931d2136c38aff397b4b1~ OR FILE_MD5 EVALUATE_BUFFER ~%bg_redux_exe%~ ~46c1b3bc2710af125525042d6d3c6eab~ OR FILE_MD5 EVALUATE_BUFFER ~%bg_redux_exe%~ ~eb8686062c6704ad9d95d4cda12487eb~) BEGIN
    PRINT ~WARNING: Executable hash differs from the verified builds. Installation will continue. Runtime will try a likely profile with native signature/layout checks; this executable has not been verified.~
  END
  OUTER_SPRINT bg_redux_family ~bg2ee~
  ACTION_IF GAME_IS ~bgee~ BEGIN OUTER_SPRINT bg_redux_family ~bgee~ END
  OUTER_SPRINT bg_redux_version ~2.6.6.0~
  ACTION_IF FILE_EXISTS ~data/PATCH27.BIF~ BEGIN OUTER_SPRINT bg_redux_version ~2.7.3.0~ END
  OUTER_SPRINT bg_redux_profile ~%bg_redux_family%-steam-%bg_redux_version%~
  ACTION_IF (~%bg_redux_family%~ STRING_EQUAL ~bg2ee~ AND ~%bg_redux_version%~ STRING_EQUAL ~2.6.6.0~) BEGIN
    OUTER_SPRINT bg_redux_profile ~bg2ee-2.6.6.0~
  END
  COPY ~bg-redux-movement/runtime/profile-hint.lua.in~ ~bg-redux-movement/installed-profile.lua~
    EVALUATE_BUFFER
  COPY ~bg-redux-movement/runtime/M_BGREDX.lua~ ~override/M_BGREDX.lua~
  ACTION_IF NOT FILE_EXISTS ~bg-redux-movement.ini~ BEGIN
    ACTION_IF FILE_EXISTS ~mrdx-movement.ini~ BEGIN
      COPY + ~mrdx-movement.ini~ ~bg-redux-movement.ini~
    END ELSE BEGIN
      COPY + ~bg-redux-movement/defaults.ini~ ~bg-redux-movement.ini~
    END
  END

  COPY ~bg-redux-movement/support/Collect BG Redux Support.cmd~ ~Collect BG Redux Support.cmd~
  ACTION_IF FILE_EXISTS ~InfinityLoader.ini~ BEGIN
    COPY ~InfinityLoader.ini~ ~InfinityLoader.ini~
      REPLACE_EVALUATE ~\([%WNL%][ %TAB%]*LogFile[ %TAB%]*=[ %TAB%]*\)\([%WNL%]\)~ BEGIN END ~%MATCH1%bg-redux-runtime.log%MATCH2%~
    BUT_ONLY
  END
